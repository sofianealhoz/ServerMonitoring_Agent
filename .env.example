# Copy to .env and fill in. .env is ignored by git: secrets never go in the repository.
# Load it with:  set -a; . ./.env; set +a      or      docker run --env-file .env ...

AGENT_ENV=prod
AGENT_DEBUG=False
AGENT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dbname_monitoring
# Long random key used to sign the JWT. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AGENT_JWT_SECRET=change-me
